{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "nextjs", "jsx-a11y"],
  "categories": {
    "correctness": "warn"
  },
  "ignorePatterns": [
    "**/*.md",
    "**/next-env.d.ts",
    "**/.next/**",
    "**/node_modules/**",
    "**/out/**",
    "**/dist/**",
    "**/coverage/**",
    "**/test-results/**",
    "**/playwright-report/**",
    "tmp/**",
    "temp/**"
  ],
  "overrides": [
    {
      "files": [
        "apps/web/components/theme-selector.tsx",
        "apps/web/components/mock/theme-toggle.tsx",
        "apps/web/components/mock/workbench.tsx"
      ],
      "rules": {
        "react/set-state-in-effect": "off"
      }
    },
    {
      "files": [
        "apps/web/components/mock/category-toggles.tsx",
        "apps/web/components/mock/theme-toggle.tsx",
        "apps/web/components/mock/workbench.tsx",
        "apps/web/app/mock/page.tsx"
      ],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    },
    {
      "files": ["apps/web/components/ui/label.tsx"],
      "rules": {
        "jsx-a11y/label-has-associated-control": "off"
      }
    },
    {
      "files": ["apps/web/components/mock/workbench.tsx"],
      "rules": {
        "jsx-a11y/click-events-have-key-events": "off",
        "jsx-a11y/no-noninteractive-tabindex": "off"
      }
    },
    {
      "files": [
        "apps/web/components/mock/workbench.tsx",
        "apps/web/components/mock/sidebar-filters.tsx"
      ],
      "rules": {
        "jsx-a11y/no-noninteractive-element-interactions": "off"
      }
    }
  ]
}
