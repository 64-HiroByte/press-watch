{
  "name": "press-watch",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "volta": {
    "node": "24.22.3"
  },
  "scripts": {
    "railway:cli": "node scripts/railway-cli.mjs",
    "typecheck:railway": "tsc --project .railway/tsconfig.json",
    "plan:railway": "node scripts/railway-cli.mjs config plan --file .railway/railway.ts --detailed-exit-code",
    "dev:web": "pnpm --filter @press-watch/web dev",
    "build:web": "pnpm --filter @press-watch/web build",
    "typecheck:web": "pnpm --filter @press-watch/web typecheck",
    "typegen:web": "pnpm --filter @press-watch/web typegen",
    "lint:web": "pnpm --filter @press-watch/web lint",
    "format:web": "pnpm --filter @press-watch/web format",
    "format:check:web": "pnpm --filter @press-watch/web format:check",
    "test:web": "pnpm --filter @press-watch/web test"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "railway": "3.16.0",
    "typescript": "7.0.2"
  }
}
