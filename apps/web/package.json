{
  "name": "@press-watch/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "typegen": "next typegen",
    "lint": "oxlint --config ../../.oxlintrc.json --deny-warnings .",
    "format": "oxfmt --config ../../.oxfmtrc.json --write \"**/*.{js,jsx,mjs,cjs,ts,tsx,css,json}\"",
    "format:check": "oxfmt --config ../../.oxfmtrc.json --check \"**/*.{js,jsx,mjs,cjs,ts,tsx,css,json}\"",
    "test": "PLAYWRIGHT_BROWSERS_PATH=\"$PWD/../../tmp/playwright/browsers\" playwright test"
  },
  "dependencies": {
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@base-ui/react": "1.8.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.50.0",
    "next-themes": "0.4.6"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "8.5.28",
    "shadcn": "4.21.1",
    "tw-animate-css": "1.4.0",
    "@playwright/test": "1.63.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
